{
  "sheet": "controls",
  "about": "Every key the mashup reads. 'vanilla' rows are Elden Ring's own bindings the design relies on; the mod reads but never rebinds them.",
  "key": "id",
  "columns": {
    "id": {
      "type": "str"
    },
    "action": {
      "type": "str"
    },
    "key_name": {
      "type": "str"
    },
    "vk_code": {
      "type": "int",
      "doc": "Windows virtual-key code"
    },
    "trigger": {
      "type": "enum",
      "values": [
        "press",
        "hold",
        "vanilla"
      ]
    },
    "owner": {
      "type": "enum",
      "values": [
        "mod",
        "vanilla"
      ]
    },
    "vanilla_conflict": {
      "type": "str",
      "doc": "what Elden Ring's default keyboard layout does with this key"
    }
  },
